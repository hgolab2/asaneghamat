645\u0648\u062c\u0648\u062f \u0646\u06cc\u0633\u062a \u0648 \u0628\u0631\u0627\u06cc \u06a9\u0646\u062a\u0631\u0644 \u0646\u0633\u062e\u0647 \u0646\u06cc\u0627\u0632 \u0628\u0647 WP Rollback Pro \u062f\u0627\u0631\u062f."],"This premium asset requires WP Rollback Pro for safe version rollbacks.":["\u0627\u06cc\u0646 \u0622\u06cc\u062a\u0645 \u067e\u0631\u06cc\u0645\u06cc\u0648\u0645 \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u06cc \u0646\u0633\u062e\u0647 \u0627\u06cc\u0645\u0646\u060c \u0646\u06cc\u0627\u0632 \u0628\u0647 WP Rollback Pro \u062f\u0627\u0631\u062f."],"Unlock Premium Rollbacks":["\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u0642\u0641\u0644 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u06cc\u200c\u0647\u0627\u06cc \u067e\u0631\u06cc\u0645\u06cc\u0648\u0645"],"Error":["\u062e\u0637\u0627"],"Learn More About Pro Features":["\u062f\u0631\u0628\u0627\u0631\u0647 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0628\u062f\u0627\u0646\u06cc\u062f"],"Go Back":["\u0628\u0627\u0632\u06af\u0634\u062a"],"Upgrade to WP Rollback Pro":["\u0627\u0631\u062a\u0642\u0627 \u0628\u0647 WP Rollback Pro"],"Try WP Rollback Pro risk-free. If you're not completely satisfied, get your money back within 30 days.":["\u0646\u0633\u062e\u0647 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0631\u0627 \u0628\u062f\u0648\u0646 \u0631\u06cc\u0633\u06a9 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f. \u0627\u06af\u0631 \u06a9\u0627\u0645\u0644\u0627\u064b \u0631\u0627\u0636\u06cc \u0646\u0628\u0648\u062f\u06cc\u062f\u060c \u0648\u062c\u0647 \u0634\u0645\u0627 \u062a\u0627 \u06f3\u06f0 \u0631\u0648\u0632 \u0628\u0627\u0632\u06af\u0634\u062a \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f."],"30-Day Money-Back Guarantee":["\u0636\u0645\u0627\u0646\u062a \u0628\u0627\u0632\u06af\u0634\u062a \u0648\u062c\u0647 \u06f3\u06f0 \u0631\u0648\u0632\u0647