"],"All versions listed below are available directly from WordPress.org.":["\u0647\u0645\u0647 \u0646\u0633\u062e\u0647\u200c\u0647\u0627\u06cc \u0641\u0647\u0631\u0633\u062a\u200c\u0634\u062f\u0647 \u062f\u0631 \u0632\u06cc\u0631\u060c \u0645\u0633\u062a\u0642\u06cc\u0645\u0627\u064b \u0627\u0632 WordPress.org \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0647\u0633\u062a\u0646\u062f."],"See all Pro features":["\u0645\u0634\u0627\u0647\u062f\u0647 \u0647\u0645\u0647 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc Pro"],"Pro archives your version before every update and supports premium plugins like Elementor, Gravity Forms, and WooCommerce. Next time something breaks, you're one click from safety.":["\u0646\u0633\u062e\u0647 Pro \u067e\u06cc\u0634 \u0627\u0632 \u0647\u0631 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc\u060c \u0646\u0633\u062e\u0647 \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627\u06cc\u06af\u0627\u0646\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0627\u0632 \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627\u06cc \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0645\u0627\u0646\u0646\u062f Elementor\u060c Gravity Forms \u0648 WooCommerce \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062f\u0641\u0639\u0647 \u0628\u0639\u062f \u06a9\u0647 \u0686\u06cc\u0632\u06cc \u062e\u0631\u0627\u0628 \u0634\u062f\u060c \u0641\u0642\u0637 \u06cc\u06a9 \u06a9\u0644\u06cc\u06a9 \u062a\u0627 \u0627\u0645\u0646\u06cc\u062a \u0641\u0627\u0635\u0644\u0647 \u062f\u0627\u0631\u06cc\u062f."],"Rollback any plugin \u2014 not just WordPress.org.":["\u0647\u0631 \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0627\u06cc \u0631\u0627 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u06cc \u06a9\u0646\u06cc\u062f \u2014 \u0646\u0647 \u0641\u0642\u0637 \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627\u06cc WordPress.org."],"WP Rollback Pro":["WP Rollback Pro"],"Activity logs":["\u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627\u06cc \u0641\u0639\u0627\u0644\u06cc\u062a"],"Auto-archives":["\u0628\u0627\u06cc\u06af\u0627\u0646\u06cc \u062e\u0648\u062f\u06a9\u0627\u0631"],"Premium plugins":["\u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627\u06cc \u062d\u0631\u0641\u0647\u200c\u0627\u06cc"],"Repo":["\u0645\u062e\u0632\u0646"],"Local":["\u0645\u062d\u0644\u06cc"],"Vault":["Vault"],"Please wait \u2014 this may take a few moments.":["\u0644\u0637\u0641\u0627\u064b \u0635\u0628\u0631 \u06a9\u0646\u06cc\u062f \u2014 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0686\u0646\u062f \u0644\u062d\u0638\u0647 \u0637\u0648\u0644 \u0628\u06a9\u0634\u062f."],"All steps completed successfully.":["\u0647\u0645\u0647 \u0645\u0631\u0627\u062d\u0644 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0634\u062f."],"Back up your files and database before continuing. WP Rollback is not responsible for issues resulting from this action.":["\u067e\u06cc\u0634 \u0627\u0632 \u0627\u062f\u0627\u0645\u0647\u060c \u0627\u0632 \u067e\u0631\u0648\u0646\u062f\u0647\u200c\u0647\u0627 \u0648 \u067e\u0627\u06cc\u06af\u0627\u0647 \u062f\u0627\u062f\u0647 \u062e\u0648\u062f \u0646\u0633\u062e\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u062a\u0647\u06cc\u0647 \u06a9\u0646\u06cc\u062f. WP Rollback \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u062f\u0631 \u0642\u0628\u0627\u0644 \u0645\u0634\u06a9\u0644\u0627\u062a \u0646\u0627\u0634\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0627\u0642\u062f\u0627\u0645 \u0646\u062f\u0627\u0631\u062f."],"Installed":["\u0646\u0635\u0628\u200c\u0634\u062f\u0647"],"Same version will be reinstalled":["\u0647\u0645\u0627\u0646 \u0646\u0633\u062e\u0647 \u062f\u0648\u0628\u0627\u0631\u0647 \u0646\u0635\u0628 \u062e\u0648\u0627\u0647\u062f \u0634\u062f"],"WordPress Theme":["\u067e\u0648\u0633\u062a\u0647 \u0648\u0631\u062f\u067e\u0631\u0633"],"WordPress Plugin":["\u0627\u0641\u0632\u0648\u0646\u0647 \u0648\u0631\u062f\u067e\u0631\u0633"],"Reinstalling":["\u062f\u0631 \u062d\u0627\u0644 \u0646\u0635\u0628 \u062f\u0648\u0628\u0627\u0631\u0647"],"Updating To":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0628\u0647"],"Rolling Back To":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u06cc \u0628\u0647"],"Update":["\u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc"],"Reinstall":["\u0646\u0635\u0628 \u062f\u0648\u0628\u0627\u0631\u0647"],"Update Now":["\u0627\u06a9\u0646\u0648\u0646 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06a9\u0646\u06cc\u062f"],"Reinstall Now":["\u0627\u06a9\u0646\u0648\u0646 \u062f\u0648\u0628\u0627\u0631\u0647 \u0646\u0635\u0628 \u06a9\u0646\u06cc\u062f"],"No themes available for rollback.":["\u067e\u0648\u0633\u062a\u0647\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u06cc \u0645\u0648\u062c\u0648\u062f \u0646\u06cc\u0633\u062a."],"No Themes Found":["\u067e\u0648\u0633\u062a\u0647\u200c\u0627\u06cc \u06cc\u0627\u0641\u062a \u0646\u0634\u062f"],"No plugins available for rollback.":["\u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u06cc \u0645\u0648\u062c\u0648\u062f \u0646\u06cc\u0633\u062a."],"No Plugins Found":["\u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0627\u06cc \u06cc\u0627\u0641\u062a \u0646\u0634\u062f"],"Data will appear here when available.":["\u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u062f\u0631 \u0635\u0648\u0631\u062a \u0645\u0648\u062c\u0648\u062f \u0628\u0648\u062f\u0646\u060c \u0627\u06cc\u0646\u062c\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."],"No Data Found":["\u062f\u0627\u062f\u0647\u200c\u0627\u06cc \u06cc\u0627\u0641\u062a \u0646\u0634\u062f"],"Read our troubleshooting guide":["\u0631\u0627\u0647\u06