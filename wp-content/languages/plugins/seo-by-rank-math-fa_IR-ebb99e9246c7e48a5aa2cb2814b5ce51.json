RL \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0628\u0647 IndexNow API \u0627\u0631\u0633\u0627\u0644 \u0634\u062f."],"Response Message":["\u067e\u0627\u0633\u062e \u067e\u06cc\u0627\u0645 "],"Response Code Help":["\u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u06a9\u062f \u067e\u0627\u0633\u062e"],"Insert URLs to send to the IndexNow API (one per line, up to 10,000):":["\u0646\u0634\u0627\u0646\u06cc\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644 \u0628\u0647 IndexNow API \u062f\u0631\u062c \u06a9\u0646\u06cc\u062f (\u06cc\u06a9\u06cc \u062f\u0631 \u0647\u0631 \u062e\u0637\u060c \u062a\u0627 10000):"],"No submissions yet.":["\u0647\u0646\u0648\u0632 \u0627\u0631\u0633\u0627\u0644\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f."],"An error occurred while submitting the URL.":["\u0647\u0646\u06af\u0627\u0645 \u0627\u0631\u0633\u0627\u0644 URL \u062e\u0637\u0627\u06cc\u06cc \u0631\u062e \u062f\u0627\u062f."],"The last 100 IndexNow API requests.":["\u0622\u062e\u0631\u06cc\u0646 100 \u062f\u0631\u062e\u0648\u0627\u0633\u062a IndexNow API."],"Send URLs directly to the IndexNow API.":["URL \u0647\u0627 \u0631\u0627 \u0645\u0633\u062a\u0642\u06cc\u0645\u0627\u064b \u0628\u0647 IndexNow API \u0627\u0631\u0633\u0627\u0644 \u06a9\u0646\u06cc\u062f."],"Error: could not clear history.":["\u062e\u0637\u0627: \u0646\u0645\u06cc \u062a\u0648\u0627\u0646 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0631\u0627 \u067e\u0627\u06a9 \u06a9\u0631\u062f."],"Submit URLs":["\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0648\u0646\u062f\u0647\u0627"],"Time":["\u0632\u0645\u0627\u0646"],"Settings":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a"],"URL":["URL"],"All":["\u0647\u0645\u0647"],"OK":["\u062a\u0627\u06cc\u06cc\u062f"],"Response Code":["\u06a9\u062f \u067e\u0627\u0633\u062e"]}},"comment":{"reference":"assets\/admin\/js\/instantIndexingSettings.js"}}